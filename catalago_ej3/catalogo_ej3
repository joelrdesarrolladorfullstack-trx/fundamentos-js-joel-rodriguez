const productos = ["teclado","raton","monitor","auriculares","webcam"];

const precios = [45.99,19.99,189.00,59.95,34.50];

const stock = [100,10,30,0,1000];


let agotados = 0;
let productomascaro = 0;
let valortotaldeinvetario = 0;

for (let i = 0; i < productos.length; i++) {
if (stock[i] === 0) {
    agotados++;
    console.log(`${productos[i]} - ${precios[i]} € - AGOTADO`);
    } else {
    console.log(`${productos[i]} - ${precios[i]} € - stock: ${stock[i]}`);
}
if (precios[i] > precios[productomascaro]){productomascaro = i;

    }
    valortotaldeinvetario += precios[i] * stock[i];
    }
    console.log (`productos agotados: ${agotados}`);
    console.log(`Producto más caro: ${productos[productomascaro]} (${precios[productomascaro]} €)`);
console.log(`Valor del inventario: ${valortotaldeinvetario.toFixed(2)} €`);


